[Desktop Entry]
# The version of the desktop entry spec this conforms to.
Version=1.0

Type=Application

Name=Octomus
GenericName=TerminalEmulator

Exec=octomus-terminal %U
StartupWMClass=dev.octomus.Octomus

Keywords=shell;prompt;command;commandline;cmd;

Icon=dev.octomus.Octomus

Categories=System;TerminalEmulator;

# Don't run this application within a terminal.
Terminal=false

# Register ourselves as the handler for octomus:// URLs.
MimeType=x-scheme-handler/octomus;
